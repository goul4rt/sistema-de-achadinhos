# Banco: SQLite por padrão (zero configuração). Para Postgres:
# DATABASE_URL=postgresql+psycopg://achadinhos:achadinhos@localhost:5432/achadinhos
DATABASE_URL=sqlite:///data/achadinhos.db

# Coleta automática
SCHEDULER_ENABLED=true
COLLECT_INTERVAL_MINUTES=10
HTTP_TIMEOUT_SECONDS=20

# Promobit (sem credencial). Páginas de "mais recentes" por ciclo (~14 ofertas/página)
PROMOBIT_ENABLED=true
PROMOBIT_PAGES=4

# Shopee Affiliate Open API (BR) - liga sozinho quando as duas variáveis existem
SHOPEE_APP_ID=
SHOPEE_SECRET=

# AliExpress Affiliate API (Open Platform) - liga sozinho quando app key + secret existem
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=
